+"""Adaptation helpers for the k1-training copy of B-Human IsaacGymRL.
+
+Patch layer added by the K1 project on top of upstream c3fed81; not part of
+the upstream repository. Provides:
+- str2bool: fixes the upstream ``type=bool`` argparse trap (--headless 0 was True)
+- load_checkpoint: explicit load modes (actor / full) with strict validation
+- save_checkpoint_v1: versioned checkpoint format with resumable bookkeeping
+- guard_finite: NaN/Inf diagnostics that fail loudly instead of reset_logstd
+"""
+import argparse
+import json
+import os
+import random
+import sys
+import time
+
+import numpy as np
+import torch
+
+CKPT_FORMAT = "bh-k1-ckpt-v1"
+SOURCE_ID = "bhuman/MachineLearning@c3fed81 + k1-training patch layer"
+
+
+def str2bool(v):
+    if isinstance(v, bool):
+        return v
+    if v is None:
+        return None
+    s = str(v).strip().lower()
+    if s in ("1", "true", "yes", "y", "on"):
+        return True
+    if s in ("0", "false", "no", "n", "off"):
+        return False
+    raise argparse.ArgumentTypeError("invalid boolean value: %r" % (v,))
+
+
+def _actor_subset(mstate, ref):
+    out = {}
+    for k, v in mstate.items():
+        if k.startswith("actor.") or k == "logstd":
+            out[k] = v
+    return out
+
+
+def load_checkpoint(model, optimizer, path, mode, device="cpu"):
+    """Load a checkpoint in an explicit mode.
+
+    mode="actor": strict validation of actor.* (+logstd) keys and shapes,
+      critic keeps its fresh initialisation, optimizer untouched.
+      -> use for replay / export / warm-start.
+    mode="full": strict load of the complete state dict, optimizer state
+      required and restored, rng restored when present. Only valid for our
+      own bh-k1-ckpt-v1 checkpoints (or structurally identical ones).
+    Returns an info dict; never masks incompatibilities.
+    """
+    print("[load] checkpoint=%s mode=%s" % (path, mode))
+    try:
+        sd = torch.load(path, map_location=device, weights_only=True)
+    except Exception as e:
+        # weights_only cannot unpickle the RNG states stored in our own v1
+        # checkpoints. Rich unpickling is allowed ONLY for files that carry the
+        # bh-k1-ckpt-v1 format marker; public/unknown files stay strict.
+        probe = torch.load(path, map_location="cpu", weights_only=False)
+        if probe.get("format") != CKPT_FORMAT:
+            raise ValueError("%s: weights_only load failed and file is not a %s checkpoint (%s)" % (path, CKPT_FORMAT, e))
+        sd = probe
+    if not isinstance(sd, dict) or "model" not in sd:
+        raise ValueError("%s: not a training checkpoint dict (missing 'model' key)" % path)
+    mstate = sd["model"]
+    ref = model.state_dict()
+
+    actor_keys = _actor_subset(mstate, ref)
+    if not actor_keys:
+        raise ValueError("%s: no actor.*/logstd keys found" % path)
+    for k, v in sorted(actor_keys.items()):
+        if k not in ref:
+            raise ValueError("%s: unexpected key %s for this model" % (path, k))
+        if tuple(ref[k].shape) != tuple(v.shape):
+            raise ValueError(
+                "%s: shape mismatch at %s: checkpoint %s vs model %s"
+                % (path, k, tuple(v.shape), tuple(ref[k].shape))
+            )
+    missing_actor = sorted(k for k in ref if (k.startswith("actor.") or k == "logstd") and k not in actor_keys)
+    if missing_actor:
+        raise ValueError("%s: missing actor keys %s" % (path, missing_actor))
+
+    not_loaded = sorted(k for k in mstate if k not in actor_keys)
+    info = {
+        "path": os.path.abspath(path),
+        "mode": mode,
+        "format": sd.get("format", "upstream"),
+        "iteration": sd.get("iteration"),
+        "env_steps": sd.get("env_steps"),
+        "lr": sd.get("lr"),
+        "has_optimizer": "optimizer" in sd,
+        "loaded_prefixes": sorted({k.split(".")[0] for k in actor_keys}),
+        "intentionally_not_loaded": not_loaded,
+        "rng_restored": False,
+    }
+
+    if mode == "actor":
+        current = {k: v for k, v in ref.items() if k not in actor_keys}
+        model.load_state_dict({**actor_keys, **current}, strict=True)
+        print("[load] actor-only load OK; intentionally not loaded: %s" % (not_loaded,))
+        return info
+
+    if mode == "full":
+        model.load_state_dict(mstate, strict=True)
+        if "optimizer" not in sd:
+            raise ValueError("%s: full mode requires optimizer state" % path)
+        optimizer.load_state_dict(sd["optimizer"])
+        rng = sd.get("rng")
+        if rng:
+            torch.set_rng_state(rng.get("torch"))
+            if rng.get("cuda") and torch.cuda.is_available():
+                torch.cuda.set_rng_state_all(rng["cuda"])
+            np.random.set_state(rng["numpy"])
+            random.setstate(rng["python"])
+            info["rng_restored"] = True
+        print("[load] full load OK (optimizer restored, rng_restored=%s)" % info["rng_restored"])
+        return info
+
+    raise ValueError("unknown load mode %r (use 'actor' or 'full')" % mode)
+
+
+def rng_snapshot():
+    snap = {
+        "torch": torch.get_rng_state(),
+        "numpy": np.random.get_state(),
+        "python": random.getstate(),
+    }
+    if torch.cuda.is_available():
+        snap["cuda"] = torch.cuda.get_rng_state_all()
+    return snap
+
+
+def save_checkpoint_v1(recorder, model, optimizer, iteration, env_steps, lr, cfg, tag, extra=None):
+    payload = {
+        "format": CKPT_FORMAT,
+        "source_id": SOURCE_ID,
+        "utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "iteration": int(iteration),
+        "env_steps": int(env_steps),
+        "lr": float(lr),
+        "model": model.state_dict(),
+        "optimizer": optimizer.state_dict(),
+        "rng": rng_snapshot(),
+        "config": cfg,
+        "not_serialized": [
+            "PhysX simulation state",
+            "per-environment states (robot poses, terrains, randomisation draws)",
+            "curriculum/adaptive-lr history beyond the stored lr",
+        ],
+    }
+    if extra:
+        payload.update(extra)
+    recorder.save(payload, tag)
+    return payload
+
+
+def guard_finite(model, scalars, diag_path):
+    """Raise SystemExit(2) after dumping diagnostics if anything is non-finite.
+
+    Replaces the upstream reset_logstd NaN branch: we fail loudly, keep the
+    last valid checkpoint untouched (this guard runs before any save) and
+    never silently zero out NaNs.
+    """
+    bad = []
+    for k, v in scalars.items():
+        if v is None:
+            continue
+        try:
+            f = float(v)
+        except (TypeError, ValueError):
+            continue
+        if not np.isfinite(f):
+            bad.append("scalar:%s=%s" % (k, f))
+    with torch.no_grad():
+        for k, p in model.named_parameters():
+            if not torch.isfinite(p).all():
+                bad.append("param:%s" % k)
+            if p.grad is not None and not torch.isfinite(p.grad).all():
+                bad.append("grad:%s" % k)
+    if not bad:
+        return
+    diag = {
+        "utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "bad": bad[:200],
+        "n_bad": len(bad),
+        "scalars": {k: (float(v) if v is not None else None) for k, v in scalars.items()},
+        "logstd": model.logstd.detach().cpu().flatten().tolist(),
+        "hint": "non-finite state detected; training halted before checkpoint overwrite",
+    }
+    os.makedirs(os.path.dirname(diag_path), exist_ok=True)
+    with open(diag_path, "w") as f:
+        json.dump(diag, f, indent=2)
+    print("[guard_finite] NON-FINITE STATE detected -> %s" % diag_path, file=sys.stderr)
+    print("[guard_finite] first issues: %s" % bad[:10], file=sys.stderr)
+    sys.exit(2)
