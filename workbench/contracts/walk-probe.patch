+// [BH_WALK_PROBE] Read-only logging of the walk policy input/output contract.
+// Active only when the environment variable BH_WALK_PROBE names an existing
+// output directory; one CSV line per record is appended to
+// $BH_WALK_PROBE/walk-probe.csv. This never alters control or physics
+// behavior, it only observes values that are computed anyway.
+namespace
+{
+  struct WalkProbeState
+  {
+    FILE* file = nullptr;
+    unsigned long counter = 0; /**< Increments once per updateHistoryData() call; the policy call that triggered it reuses the id. */
+    bool metaWritten = false;
+
+    void open()
+    {
+      if(file)
+        return;
+      const char* dir = std::getenv("BH_WALK_PROBE");
+      if(!dir || !*dir)
+        return;
+      file = std::fopen((std::string(dir) + "/walk-probe.csv").c_str(), "w");
+    }
+
+    bool active()
+    {
+      open();
+      return file != nullptr;
+    }
+  };
+
+  WalkProbeState& walkProbeState()
+  {
+    static WalkProbeState state;
+    return state;
+  }
+}
 
 MAKE_MODULE(WalkingEngine);
 
