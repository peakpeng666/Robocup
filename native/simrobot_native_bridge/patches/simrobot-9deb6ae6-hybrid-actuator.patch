+
+// This capability is intentionally independent of setValue()/GUI position controls.
+bool ServoMotor::setHybridCommand(const SimRobotCore3::HybridCommand& command)
+{
+  hybridLease.reject();
+  if(!joint || isPuppet || !SimRobotCore3::validHybridCommand(command))
+    return false;
+  const auto* model = Simulation::simulation->model;
+  if(!model || model->jnt_type[joint->jointIndex] != mjJNT_HINGE)
+    return false; // API units here are radians and Nm, not slider units.
+  const auto* deflection = joint->axis->deflection;
+  if(deflection && !SimRobotCore3::validHybridTargetReference(command, deflection->min, deflection->max))
+    return false;
+  return hybridLease.submit(command);
+}
+
+void ServoMotor::useLegacyControl()
+{
+  if(!hybridLease.active())
+    return;
+  hybridLease.clear();
+  // Do not resurrect a pre-hybrid delay-queue target.
+  if(joint && Simulation::simulation->model && Simulation::simulation->data)
+  {
+    const auto* model = Simulation::simulation->model;
+    const auto* data = Simulation::simulation->data;
+    setpoint = lastPos = static_cast<float>(data->qpos[model->jnt_qposadr[joint->jointIndex]]);
+    currentAngularVelocity = static_cast<float>(data->qvel[model->jnt_dofadr[joint->jointIndex]]);
+    lastExecutedSetpoint = {setpoint, static_cast<float>(Simulation::simulation->simulatedTime)};
+    for(unsigned i = 0; i < targetSize; ++i)
+      target[i] = lastExecutedSetpoint;
+    index = 0;
+  }
+}
