+void GameController::exportRefereeFrame(uint64_t stepNs)
+{
+  if(!refereeFrameConfigured)
+  {
+    refereeFramePublisher.enableFileFromEnvironment(); // absent/empty means disabled
+    refereeFrameConfigured = true;
+  }
+  if(!refereeFramePublisher.enabled())
+    return;
+  if(!stepNs || refereeFrameTimeNs > std::numeric_limits<uint64_t>::max() - stepNs)
+    throw std::overflow_error("invalid referee simulation clock");
+  GameControllerData visibleData;
+  getGameControllerData(visibleData); // Preserve public delay/score masking and team order.
+  refereeFramePublisher.publish(refereeFrameTimeNs, visibleData);
+  refereeFrameTimeNs += stepNs;
+}
